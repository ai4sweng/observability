# Copy this file to ".env" and fill in the values before "docker compose up".

# --- Identity — must be unique across ALL running KIOs (local + remote) ---
KIO_ID=kio5
KIO_LLM=claude-sonnet
KIO_TASK_TYPE=generic
SERVICE_VERSION=1.0.0

# --- Where the CENTRAL collector lives (the machine running the main stack) ---
# Same-LAN example:      http://192.168.1.50:4317
# Tailscale/VPN example:  http://100.x.y.z:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://CHANGE-ME:4317

# --- REQUIRED as of 2026-08 (§9.3): the central collector's bearertokenauth
# extension now rejects any OTLP call without this header. Ask the central
# platform owner for the current OTLP_BEARER_TOKEN value (docker-compose.yml's
# otel-collector service / repo-root .env) — it's shared by every KIO, not
# unique per KIO. ---
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer CHANGE-ME

# --- Timing (seconds/ms) — same defaults as the local KIOs ---
EXPORT_INTERVAL_MS=15000
HEARTBEAT_INTERVAL_S=60
REQUEST_INTERVAL_S=3

# --- Optional: D1.1 real-project KPIs (2026-08). Leave commented out unless
# this KIO fills one of these roles — see docs/AI4SWENG_KPI_Metrik_Referansi.
# Valid values: bugfix | nlp-requirements | architecture-to-code | ai-sysdev |
#               green-deploy | adoption
# KIO_REAL_KPI_ROLE=

# --- Optional: NATS-driven task dispatch (orchestration layer, separate from
# telemetry — see main README's "Orchestration layer" section). Only needed if
# this KIO should ALSO be triggerable via the central machine's Workflow API
# (POST /workflow/run). Leave off if this KIO should just run on its own
# internal timer, which is the default and requires nothing here. ---
# NATS_ENABLED=true
# NATS_URL=nats://CHANGE-ME:4222

# --- Langfuse — second, parallel telemetry stream (LLM prompts/cost) ---
# Public/secret key pair must match LANGFUSE_INIT_PROJECT_PUBLIC_KEY /
# _SECRET_KEY set on the central langfuse-web service (docker-compose.yml).
# Base URL points at the central machine's PUBLISHED port (3001, not 3000 —
# that's Grafana's port on the same host), same Tailscale/LAN IP as above.
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE-ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE-ME
LANGFUSE_BASE_URL=http://CHANGE-ME:3001
