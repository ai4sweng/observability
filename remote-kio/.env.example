# Copy this file to ".env" and fill in the values before "docker compose up".

# --- Identity — must be unique across ALL running KIOs (local + remote) ---
KIO_ID=kio5
KIO_LLM=claude-sonnet
KIO_TASK_TYPE=generic
SERVICE_VERSION=1.0.0

# --- Where the CENTRAL collector lives (the machine running the main stack) ---
# Same-LAN example:      http://192.168.1.50:4317
# Tailscale/VPN example:  http://100.x.y.z:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://CHANGE-ME:4317

# --- Optional: only used once the central collector has Bearer auth enabled ---
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer YOUR_TOKEN

# --- Timing (seconds/ms) — same defaults as the local KIOs ---
EXPORT_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_S=60
REQUEST_INTERVAL_S=3

# --- Langfuse — second, parallel telemetry stream (LLM prompts/cost) ---
# Public/secret key pair must match LANGFUSE_INIT_PROJECT_PUBLIC_KEY /
# _SECRET_KEY set on the central langfuse-web service (docker-compose.yml).
# Base URL points at the central machine's PUBLISHED port (3001, not 3000 —
# that's Grafana's port on the same host), same Tailscale/LAN IP as above.
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGE-ME
LANGFUSE_SECRET_KEY=sk-lf-CHANGE-ME
LANGFUSE_BASE_URL=http://CHANGE-ME:3001
