# Copy this file to ".env" and edit the values, then run `python main.py`.
# main.py auto-loads this .env; shell/exported variables take precedence.

# --- Identity — kio.id MUST be unique across all running KIOs, and should be
#     assigned/coordinated with the central platform team. ---
KIO_ID=kio-demo
SERVICE_VERSION=1.0.0
KIO_LLM=demo-model
KIO_TASK_TYPE=demo
DEPLOYMENT_ENVIRONMENT=demo

# --- Where the central collector lives (OTLP/gRPC, port 4317) ---
# Same machine as the platform:   http://localhost:4317
# Different machine (same LAN):    http://<platform-ip>:4317
# Different network (Tailscale):   http://<tailscale-ip>:4317
# See NETWORK.md to find the address and open the firewall.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Auth: the central collector REQUIRES a bearer token. Ask the platform
#     team for the value; the local-dev default is shown here. ---
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer local-dev-otlp-token

# --- Timing (heartbeat must stay <= 60s; >120s silence = flagged stale) ---
EXPORT_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_S=60
REQUEST_INTERVAL_S=3
