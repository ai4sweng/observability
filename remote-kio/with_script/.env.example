# Copy this file to ".env" and edit the values, then run `python main.py`.
# main.py auto-loads this .env; shell/exported variables take precedence.

# --- Identity — kio.id MUST be unique across all running KIOs, and should be
#     assigned/coordinated with the central platform team. ---

# KIO_ID=kio-demo                 # (DELETE COMMENT AFTER EDITING) YOUR KIO's unique ID (ask the platform team for a value)
# SERVICE_VERSION=1.0.0           # (DELETE COMMENT AFTER EDITING) YOUR SERVICE's version
# KIO_LLM=demo-model              # (DELETE COMMENT AFTER EDITING) YOUR LLM's name
# KIO_TASK_TYPE=demo              # (DELETE COMMENT AFTER EDITING) YOUR KIO's task type (for metrics/logs/traces grouping)
# DEPLOYMENT_ENVIRONMENT=demo     # (DELETE COMMENT AFTER EDITING) YOUR KIO's deployment environment (for metrics/logs/traces grouping)

KIO_ID=kiox                 
SERVICE_VERSION=1.0.0           
KIO_LLM=demo-model              
KIO_TASK_TYPE=demo              
DEPLOYMENT_ENVIRONMENT=demo       

# --- Where the central collector lives (OTLP/gRPC, port 4317) ---
# Same machine as the platform:   http://localhost:4317
# Different machine - OTLP/gRPC(same LAN):    http://<platform-ip>:4318
# Different network - OTLP/gRPC(Tailscale):   http://<tailscale-ip>:4318
# See NETWORK.md to find the address and open the firewall.

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Auth: the central collector REQUIRES a bearer token. Ask the platform
#     team for the value; the local-dev default is shown here. ---
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer local-dev-otlp-token

# --- Timing (heartbeat must stay <= 60s; >120s silence = flagged stale) ---
EXPORT_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_S=60
REQUEST_INTERVAL_S=3

# --- OPTIONAL: Langfuse stream (LLM prompt/completion/cost) ---
# A separate, opt-in second stream. The mandatory metrics + Grafana above work
# WITHOUT this — leave it commented unless you specifically want prompt-level
# tracing. To enable: (1) uncomment the two keys below, (2) uncomment `langfuse`
# in requirements.txt and reinstall.
# The Langfuse host is auto-derived from the OTLP IP above (same machine, port
# 3001) — you set the address only once. Override with LANGFUSE_PORT, or set a
# full LANGFUSE_HOST, if your setup differs.
# These are the shared project keys; the platform team gives you the current
# values. Treat the secret key as a credential (don't post it publicly).
# LANGFUSE_PUBLIC_KEY=pk-lf-724e64325a5bb595077226d8129117fd
# LANGFUSE_SECRET_KEY=sk-lf-484c3829fc7dd2b09018278cc02f5318
# LANGFUSE_PORT=3001
