# Reference-client config. Copy to ".env" and edit, then load it into your
# shell before running check_connectivity.py / example_kio.py.
#
#   Linux/macOS:  set -a; . ./.env; set +a
#   PowerShell:   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#][^=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
#
# (These scripts read plain environment variables — they do NOT auto-load .env
# themselves, on purpose, to stay dependency-free. In a real KIO container you
# would set these as normal container env vars instead.)

# --- Where the CENTRAL collector lives (the machine running the main stack) ---
# gRPC, port 4317 (NOT 4318 — that's the HTTP port; this client uses gRPC).
# Same-LAN example:      http://192.168.1.50:4317
# Tailscale/VPN example: http://100.x.y.z:4317
# See NETWORK.md for how to find this address and open the firewall.
OTEL_EXPORTER_OTLP_ENDPOINT=http://CHANGE-ME:4317

# --- Identity (Contract §1.2). Either set OTEL_RESOURCE_ATTRIBUTES (the
# contract-standard, authoritative form)... ---
OTEL_RESOURCE_ATTRIBUTES=service.name=kio1,service.version=1.0.0,kio.id=kio1,deployment.environment=production

# --- ...OR the discrete convenience vars below (ignored for any key that
# OTEL_RESOURCE_ATTRIBUTES already sets). kio.id MUST be unique across ALL
# running KIOs (local + remote) and should be coordinated with the central
# platform team (Contract §1.1). ---
# KIO_ID=kio1
# SERVICE_VERSION=1.0.0
# KIO_LLM=claude-sonnet
# KIO_TASK_TYPE=generic
# DEPLOYMENT_ENVIRONMENT=production

# --- Only needed once the central collector has Bearer auth + TLS enabled.
# With an http:// endpoint the client connects insecure (fine for LAN/VPN);
# with an https:// endpoint TLS is used and this header authorizes the export. ---
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer YOUR_TOKEN

# --- Timing. 5s export is fine for a handful of KIOs; the contract's own
# reference uses 15s, worth raising at higher scale. Heartbeat MUST stay <=60s
# (a KIO silent >120s is marked stale). ---
EXPORT_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_S=60
REQUEST_INTERVAL_S=3
