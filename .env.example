# Copy to .env (repo root, already gitignored) and adjust for your setup.
# docker-compose.yml reads this automatically via `docker compose up`.
# Every variable below has a default baked into docker-compose.yml matching
# the value shown here — an absent .env, or any single line left commented
# out, changes nothing. Uncomment only what you need to override.

# -----------------------------------------------------------------------------
# Host address (Windows/Linux, local vs. remote deployment)
# -----------------------------------------------------------------------------
# The address a BROWSER uses to reach this machine's Langfuse UI — NOT the
# Docker-internal network, and not necessarily the same as the machine
# running `docker compose`.
# - Local dev (browser on the same machine as Docker, Windows or Linux):
#   leave commented out, defaults to "localhost".
# - Remote Ubuntu server (you run `docker compose up` on the server, then
#   open the Langfuse UI from a different machine's browser): set this to
#   the server's reachable IP/hostname or a VPN/Tailscale address.
# Getting this wrong on a remote deployment breaks Langfuse login (NextAuth
# redirects to the wrong host) and multi-modal media previews (presigned
# URLs point at the wrong host). Core OTel telemetry (Grafana dashboards,
# traces, metrics, logs) and Langfuse trace/cost data are unaffected either
# way — those never go through PUBLIC_HOST.
# PUBLIC_HOST=192.168.1.50

# -----------------------------------------------------------------------------
# Host ports — change any of these if it collides with something already
# running on your machine. Only the host (left) side changes; containers
# keep talking to each other over their fixed internal ports regardless.
# -----------------------------------------------------------------------------
# GRAFANA_PORT=3000
# LANGFUSE_PORT=3001
# OTEL_GRPC_PORT=4317
# OTEL_HTTP_PORT=4318
# VICTORIAMETRICS_PORT=8428
# VICTORIALOGS_PORT=9428
# TEMPO_PORT=3200
# MINIO_PORT=9090
# NATS_CLIENT_PORT=4222
# NATS_MONITOR_PORT=8222
# WORKFLOW_API_PORT=8080
# METRICS_API_PORT=8081

# -----------------------------------------------------------------------------
# KIO simulator behavior — tune these down for a long unattended run (a
# remote-server soak test, say) to slow the rate telemetry accumulates in
# VictoriaMetrics/VictoriaLogs/Tempo and especially in Langfuse's Postgres/
# ClickHouse/MinIO, which have no retention/pruning configured and otherwise
# grow for as long as the KIOs keep emitting.
# -----------------------------------------------------------------------------
# Shared by all 6 KIO simulators (kio2-sim, kio3, kio4, kio7, kio8, kio13) —
# how often each exports metrics/logs/traces, and how often it heartbeats.
# KIO_EXPORT_INTERVAL_MS=15000
# KIO_HEARTBEAT_INTERVAL_S=60

# Per-KIO simulated request cadence — deliberately different per KIO in the
# defaults (each represents a different simulated workload), so these are
# separate vars rather than one shared one. Lower value = more frequent
# simulated requests = faster telemetry/Langfuse growth; raise the number to
# slow a specific KIO down without touching the others.
# KIO2_REQUEST_INTERVAL_S=3
# KIO3_REQUEST_INTERVAL_S=2
# KIO4_REQUEST_INTERVAL_S=4
# KIO7_REQUEST_INTERVAL_S=5
# KIO8_REQUEST_INTERVAL_S=5
# KIO13_REQUEST_INTERVAL_S=5

# kio2-sim only: real Ollama LLM calls + real GPU energy/temperature via
# NVML, instead of simulated numbers. Off by default. Needs Ollama running
# natively on this host (see README's "Real LLM integration") — only turn
# this on if that host actually has a GPU/Ollama available (not a headless
# remote test server).
# KIO2_REAL_LLM_ENABLED=false

# -----------------------------------------------------------------------------
# Passwords / keys — all "local-dev only" placeholder values in
# docker-compose.yml. Rotate them here before any real/shared deployment;
# each is used consistently everywhere it needs to match (e.g.
# LANGFUSE_PROJECT_PUBLIC_KEY/SECRET_KEY are shared by langfuse-web's
# headless init AND every KIO simulator that authenticates against it — one
# change here updates all of them instead of hunting through six services).
# -----------------------------------------------------------------------------
# LANGFUSE_POSTGRES_PASSWORD=8uFM7CaLqvYIH5pkutgnLPtm
# LANGFUSE_CLICKHOUSE_PASSWORD=BxK0EmwznkyJ4lSkEXAMpt8D
# LANGFUSE_MINIO_ROOT_PASSWORD=b5jzlZ-NNeSu7q5Ix7-PtD6m
# LANGFUSE_REDIS_PASSWORD=EQ_2-5L9BKy-rwiX96RsSwg8
# LANGFUSE_SALT=c0882796a7b780c36201e7464099181f
# LANGFUSE_ENCRYPTION_KEY must stay a 64-char hex string (256-bit) — Langfuse
# validates this at startup and refuses to boot otherwise. Generate a new one
# with: openssl rand -hex 32
# LANGFUSE_ENCRYPTION_KEY=175f2c3e3adbb5d0b0a22a13d8be6cc2e855332cdc5f4001a42dfb7a9b81a1b6
# LANGFUSE_NEXTAUTH_SECRET=6a79d40fac2f5d085d8116cf720d2b3e5e4c1ce9043adbc2
# LANGFUSE_PROJECT_PUBLIC_KEY=pk-lf-724e64325a5bb595077226d8129117fd
# LANGFUSE_PROJECT_SECRET_KEY=sk-lf-484c3829fc7dd2b09018278cc02f5318
# LANGFUSE_INIT_USER_PASSWORD=admin1234
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=admin
# Anonymous viewers are ON by default (GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer, hardcoded
# in docker-compose.yml, not overridable here) — anyone reaching :3000 can browse
# dashboards without logging in, but editing/deleting/datasources/alerting/user
# management all require the admin login above. Was Admin (full control, zero
# login) until 2026-08 — see README's "Design notes & decisions".
# ORCHESTRATOR_POSTGRES_PASSWORD=orchestrator
# OTLP Bearer token (2026-08, §9.3): the otel-collector now REQUIRES this on
# every OTLP call (grpc:4317 and http:4318 both). Shared by otel-collector's
# bearertokenauth extension AND every KIO's OTEL_EXPORTER_OTLP_HEADERS — one
# change here rotates it everywhere at once, same pattern as the Langfuse keys
# above. Rotate before any real/shared deployment; the placeholder below is
# fine for solo local dev only.
# OTLP_BEARER_TOKEN=local-dev-otlp-token
