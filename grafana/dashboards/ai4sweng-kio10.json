{
  "uid": "ai4sweng-kio10",
  "title": "AI4SWENG — KIO10 Detail",
  "tags": [
    "ai4sweng",
    "kio"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "Requests/sec",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(kio_request_count{kio_id=\"$kio_id\"}[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate %",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100*sum(rate(kio_request_error_count{kio_id=\"$kio_id\"}[5m]))/clamp_min(sum(rate(kio_request_count{kio_id=\"$kio_id\"}[5m])),1e-9)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Latency p95",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(kio_request_duration_ms_bucket{kio_id=\"$kio_id\"}[5m])))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pareto front size",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "description": "Non-dominated variants offered by the last runs (accuracy / flash / RAM / energy).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "last_over_time(kio_pipeline_front_size_sum{kio_id=\"$kio_id\"}[1h])/clamp_min(last_over_time(kio_pipeline_front_size_count{kio_id=\"$kio_id\"}[1h]),1)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Chosen variant MAE (cycles)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "description": "Validation accuracy of the variant the ladder selected.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "last_over_time(kio_pipeline_chosen_mae_sum{kio_id=\"$kio_id\"}[1h])/clamp_min(last_over_time(kio_pipeline_chosen_mae_count{kio_id=\"$kio_id\"}[1h]),1)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Energy/inference (mJ, ESTIMATE)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "description": "MAC-model estimate until the hardware bench exists; the method label will switch to hardware_meter then.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "last_over_time(kio_pipeline_energy_estimate_mj_sum{kio_id=\"$kio_id\"}[1h])/clamp_min(last_over_time(kio_pipeline_energy_estimate_mj_count{kio_id=\"$kio_id\"}[1h]),1)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate (ok vs error)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status)(rate(kio_request_count{kio_id=\"$kio_id\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (ms)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le)(rate(kio_request_duration_ms_bucket{kio_id=\"$kio_id\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(kio_request_duration_ms_bucket{kio_id=\"$kio_id\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le)(rate(kio_request_duration_ms_bucket{kio_id=\"$kio_id\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ladder outcomes (runs per 30m)",
      "description": "selected = fits as requested; device_swap = registry fallback chip; concession = authorized limit relaxation; needs_clarification = priced options escalated to the engineer.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome)(increase(kio_pipeline_resolution_count{kio_id=\"$kio_id\"}[30m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Chosen variant MAE (cycles)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "kio_pipeline_chosen_mae_sum{kio_id=\"$kio_id\"}/clamp_min(kio_pipeline_chosen_mae_count{kio_id=\"$kio_id\"},1)",
          "legendFormat": "avg MAE"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Energy per inference (mJ) by method",
      "description": "estimate now; hardware_meter once the bench measures — the KPI 2.1/2.2 evidence starts only from that series.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (method)(kio_pipeline_energy_estimate_mj_sum{kio_id=\"$kio_id\"})/clamp_min(sum by (method)(kio_pipeline_energy_estimate_mj_count{kio_id=\"$kio_id\"}),1)",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "type": "traces",
      "title": "Recent traces (click one for the pipeline waterfall)",
      "description": "Each request's step-by-step timing: load_data -> train -> compress_grid -> pareto_front -> conflict_ladder.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{resource.kio.id=\"$kio_id\"}",
          "limit": 20
        }
      ]
    },
    {
      "type": "logs",
      "title": "Log stream for kio10",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "expr": "kio.id:$kio_id"
        }
      ]
    }
  ],
  "version": 2,
  "templating": {
    "list": [
      {
        "name": "kio_id",
        "type": "custom",
        "query": "kio10",
        "sort": 1,
        "current": {
          "selected": true,
          "text": "kio10",
          "value": "kio10"
        },
        "options": [
          {
            "selected": true,
            "text": "kio10",
            "value": "kio10"
          }
        ]
      }
    ]
  }
}
