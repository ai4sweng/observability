{
  "uid": "ai4sweng-kio10",
  "title": "AI4SWENG — KIO10 Detail",
  "tags": [
    "ai4sweng",
    "kio"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "row",
      "title": "D1.1 Project KPIs — KIO10  (live pipeline; energy = estimate until the hardware bench)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "KPI 2.2 — Energy efficiency (intelligence/watt, inf/J)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Inferences per second per watt = inferences per joule. TinyML analogue of grant KPI 2.2 (tokens/s/W). Estimate until the bench.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5ee6a0"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(kio_pipeline_inferences_per_joule_sum{kio_id=\"$kio_id\"})/clamp_min(sum(kio_pipeline_inferences_per_joule_count{kio_id=\"$kio_id\"}),1)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "KPI 2.1 — Energy per inference (mJ, ESTIMATE)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Per-inference energy of the chosen variant. % reduction vs baseline awaits the hardware bench (KPI 2.1 target: <=85% of baseline).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4,
          "color": {
            "mode": "fixed",
            "fixedColor": "#f0a35e"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(kio_pipeline_energy_estimate_mj_sum{kio_id=\"$kio_id\"})/clamp_min(sum(kio_pipeline_energy_estimate_mj_count{kio_id=\"$kio_id\"}),1)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Model accuracy — chosen MAE (cycles)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Validation MAE of the variant the ladder selected (lower is better).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5ee6a0"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(kio_pipeline_chosen_mae_sum{kio_id=\"$kio_id\"})/clamp_min(sum(kio_pipeline_chosen_mae_count{kio_id=\"$kio_id\"}),1)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pipeline success rate",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Share of runs finishing success (vs failure/clarification).",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5ee6a0"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "100*sum(rate(kio_request_count{kio_id=\"$kio_id\",status=\"ok\"}[5m]))/clamp_min(sum(rate(kio_request_count{kio_id=\"$kio_id\"}[5m])),1e-9)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Requests/sec",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(kio_request_count{kio_id=\"$kio_id\"}[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate %",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100*sum(rate(kio_request_error_count{kio_id=\"$kio_id\"}[5m]))/clamp_min(sum(rate(kio_request_count{kio_id=\"$kio_id\"}[5m])),1e-9)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Latency p95",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(kio_request_duration_ms_bucket{kio_id=\"$kio_id\"}[5m])))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pareto front size",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 6
      },
      "description": "Non-dominated variants offered by the last runs (accuracy / flash / RAM / energy).",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "last_over_time(kio_pipeline_front_size_sum{kio_id=\"$kio_id\"}[1h])/clamp_min(last_over_time(kio_pipeline_front_size_count{kio_id=\"$kio_id\"}[1h]),1)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Chosen variant MAE (cycles)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 6
      },
      "description": "Validation accuracy of the variant the ladder selected.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "last_over_time(kio_pipeline_chosen_mae_sum{kio_id=\"$kio_id\"}[1h])/clamp_min(last_over_time(kio_pipeline_chosen_mae_count{kio_id=\"$kio_id\"}[1h]),1)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Energy/inference (mJ, ESTIMATE)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 6
      },
      "description": "MAC-model estimate until the hardware bench exists; the method label will switch to hardware_meter then.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "last_over_time(kio_pipeline_energy_estimate_mj_sum{kio_id=\"$kio_id\"}[1h])/clamp_min(last_over_time(kio_pipeline_energy_estimate_mj_count{kio_id=\"$kio_id\"}[1h]),1)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate (ok vs error)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status)(rate(kio_request_count{kio_id=\"$kio_id\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (ms)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le)(rate(kio_request_duration_ms_bucket{kio_id=\"$kio_id\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(kio_request_duration_ms_bucket{kio_id=\"$kio_id\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le)(rate(kio_request_duration_ms_bucket{kio_id=\"$kio_id\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ladder outcomes (runs per 30m)",
      "description": "selected = fits as requested; device_swap = registry fallback chip; concession = authorized limit relaxation; needs_clarification = priced options escalated to the engineer.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome)(increase(kio_pipeline_resolution_count{kio_id=\"$kio_id\"}[30m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Chosen variant MAE (cycles)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "kio_pipeline_chosen_mae_sum{kio_id=\"$kio_id\"}/clamp_min(kio_pipeline_chosen_mae_count{kio_id=\"$kio_id\"},1)",
          "legendFormat": "avg MAE"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Energy per inference (mJ) by method",
      "description": "estimate now; hardware_meter once the bench measures — the KPI 2.1/2.2 evidence starts only from that series.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (method)(kio_pipeline_energy_estimate_mj_sum{kio_id=\"$kio_id\"})/clamp_min(sum by (method)(kio_pipeline_energy_estimate_mj_count{kio_id=\"$kio_id\"}),1)",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent traces (open one for the pipeline waterfall)",
      "description": "Each request's step-by-step timing: load_data -> train -> compress_grid -> pareto_front -> conflict_ladder.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceqlSearch",
          "limit": 20,
          "tableType": "traces",
          "filters": [
            {
              "id": "kio",
              "tag": "kio.id",
              "operator": "=",
              "value": [
                "$kio_id"
              ],
              "valueType": "string",
              "scope": "resource"
            }
          ]
        }
      ]
    },
    {
      "type": "logs",
      "title": "Log stream for kio10",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "expr": "kio.id:$kio_id"
        }
      ]
    },
    {
      "type": "row",
      "title": "Efficiency & Agent-shell LLM",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Throughput (inferences/s, estimate)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "expr": "sum(kio_pipeline_inferences_per_second_sum{kio_id=\"$kio_id\"})/clamp_min(sum(kio_pipeline_inferences_per_second_count{kio_id=\"$kio_id\"}),1)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "description": "On-device inference throughput of the chosen variant (estimate until the bench)."
    },
    {
      "type": "timeseries",
      "title": "Intelligence per watt — inferences/joule (estimate)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 36
      },
      "targets": [
        {
          "expr": "sum(kio_pipeline_inferences_per_joule_sum{kio_id=\"$kio_id\"})/clamp_min(sum(kio_pipeline_inferences_per_joule_count{kio_id=\"$kio_id\"}),1)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "description": "Inferences per second per watt: the TinyML analogue of grant KPI 2.2 (tokens/s/W). Estimate until the hardware bench."
    },
    {
      "type": "timeseries",
      "title": "Inference latency (ms/inference, estimate)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "targets": [
        {
          "expr": "sum(kio_pipeline_latency_ms_per_inference_sum{kio_id=\"$kio_id\"})/clamp_min(sum(kio_pipeline_latency_ms_per_inference_count{kio_id=\"$kio_id\"}),1)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "description": "Per-inference on-device latency of the chosen variant (estimate)."
    },
    {
      "type": "timeseries",
      "title": "LLM tokens (agent-shell narration)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 44
      },
      "targets": [
        {
          "expr": "sum by (direction)(increase(kio_llm_token_count{kio_id=\"$kio_id\"}[30m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "description": "Real tokens from the one narration call per run (0 when narration is off)."
    },
    {
      "type": "timeseries",
      "title": "Narration throughput (tokens/sec)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 44
      },
      "targets": [
        {
          "expr": "sum(kio_llm_tokens_per_second_sum{kio_id=\"$kio_id\"})/clamp_min(sum(kio_llm_tokens_per_second_count{kio_id=\"$kio_id\"}),1)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "description": "tokens/s of the agent-shell explanation call."
    },
    {
      "type": "timeseries",
      "title": "Time to first token (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 44
      },
      "targets": [
        {
          "expr": "sum(kio_llm_time_to_first_token_ms_sum{kio_id=\"$kio_id\"})/clamp_min(sum(kio_llm_time_to_first_token_ms_count{kio_id=\"$kio_id\"}),1)",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          }
        }
      ],
      "description": "TFT of the streamed narration."
    },
    {
      "type": "row",
      "title": "D1.1 KPIs — actual vs threshold (KIO10, estimate until bench)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "KPI 2.1 — Lifecycle energy (% of baseline)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Green = KIO10 lifecycle energy as % of the (provisional) baseline; red = 85% target (≤ passes). Estimate until the hardware bench.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "actual (estimate)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "threshold"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "legendFormat": "actual (estimate)",
          "expr": "100*(sum(kio_pipeline_energy_estimate_mj_sum{kio_id=\"$kio_id\"})/clamp_min(sum(kio_pipeline_energy_estimate_mj_count{kio_id=\"$kio_id\"}),1))/$baseline_energy_mj"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "legendFormat": "threshold",
          "expr": "vector(85)"
        }
      ]
    },
