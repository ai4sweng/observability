    {
      "id": 20,
      "title": "Time since last heartbeat (seconds)",
      "type": "table",
      "description": "Every KIO must publish a heartbeat every 60s (Contract §2.3). Values exceeding 120s (2x the interval) turn red — see the 'Stale KIO' alert rule in grafana/provisioning/alerting/rules.yml, which fires on the same threshold in the Alerting tab.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "time() - max by (kio_id) (timestamp(kio_heartbeat))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "kio_id": "KIO",
              "Value": "Last heartbeat (s ago)"
            },
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "cellOptions": {
              "type": "color-background"
            },
            "align": "auto"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
