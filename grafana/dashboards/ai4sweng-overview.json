{
  "uid": "ai4sweng-overview",
  "title": "AI4SWENG — Overview (All KIOs)",
  "tags": [
    "ai4sweng",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
