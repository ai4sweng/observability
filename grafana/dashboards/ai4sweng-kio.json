   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed"
     },
     "thresholds": {
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "name"
   }
  },
