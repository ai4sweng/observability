{
 "uid": "ai4sweng-kio",
 "title": "AI4SWENG — KIO Detail",
 "tags": [
  "ai4sweng",
  "kio"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "kio_id",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "victoriametrics"
    },
    "query": {
     "query": "label_values(kio_heartbeat, kio_id)",
     "refId": "A"
    },
    "refresh": 2,
    "sort": 1,
    "current": {},
    "includeAll": false,
    "label": "KIO"
   },
   {
    "name": "trace_id",
    "type": "textbox",
    "label": "Trace ID (aşağıdaki tablodan kopyala)",
    "query": "",
    "current": {
     "value": "",
     "text": ""
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "title": "LLM",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "count by (llm) (kio_heartbeat{kio_id=\"$kio_id\"})",
     "legendFormat": "{{llm}}",
     "refId": "A",
     "range": true
